<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Con Hardened Runtime, cada acceso protegido debe declararse aquí. -->
    <!-- Leer eventos y recordatorios (EventKit; cubre ambos). -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- Espejo de la cámara en el panel. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- Enviar Apple Events a Música para leer y controlar la reproducción. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
