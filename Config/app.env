# Identidad del producto. Único lugar donde se define el nombre comercial:
# Scripts/build-app.sh genera el Info.plist a partir de estos valores y el
# código los lee en tiempo de ejecución desde el bundle (ver AppIdentity).
APP_NAME="NotchFlow"
BUNDLE_ID="com.axeldiaz.notchflow"
APP_VERSION="0.2.0"
APP_BUILD="2"
MIN_MACOS="14.0"
